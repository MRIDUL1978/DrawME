{
  "name": "drawme-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:onboarding": "vite --open onboarding.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "firefox": "npm run build && web-ext run --source-dir dist/firefox"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^13.4.0",
    "gsap": "^3.13.0",
    "konva": "^10.0.8",
    "perfect-freehand": "^1.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13",
    "web-ext": "^8.9.0"
  }
}
